DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE
GUILD_ID=YOUR_GUILD_ID_HERE
VOICE_CHANNEL_ID=YOUR_VOICE_CHANNEL_ID_HERE
TEXT_CHANNEL_ID=YOUR_TEXT_CHANNEL_ID_HERE
PLAYER_BACKEND=beefweb
BEEFWEB_BASE_URL=http://127.0.0.1:8880
FFMPEG_PATH=ffmpeg

# Audio input — Linux / PipeWire / PulseAudio (default)
FFMPEG_INPUT_FORMAT=pulse
FFMPEG_INPUT_DEVICE=discord_relay.monitor
# Old PULSE_SOURCE is still accepted as a fallback (backward-compatible)
# PULSE_SOURCE=discord_relay.monitor

# Audio input — Windows / foobar2000 + VB-Audio Virtual Cable
# FFMPEG_INPUT_FORMAT=dshow
# FFMPEG_INPUT_DEVICE=audio=CABLE Output (VB-Audio Virtual Cable)
STATUS_POLL_MS=10000
WEB_UI_ENABLED=false
WEB_UI_PORT=3000
APPROVED_USER_IDS=
OPUS_BITRATE=256k

# Monochrome / Hi-Fi API (Tidal search & streaming)
# MONOCHROME_API_BASE_URLS=https://monochrome-api.samidy.com,https://tidal.squid.wtf
# MONOCHROME_QUALITY=HIGH
# MONOCHROME_SEARCH_LIMIT=8
# QOBUZ_BASE_URLS=https://qobuz.kennyy.com.br,https://qobuz.squid.wtf

# --- Online stream playback ---
# DeaDBeeF (Linux) cannot reliably stream remote audio, so online tracks are
# downloaded to a local cache file first. foobar2000 (Windows) streams fine.
# auto (default) = ON for Linux/DeaDBeeF, OFF for Windows/foobar2000.
# STREAM_DOWNLOAD=auto        # or: on | off
# When ON, STREAM_CACHE_DIR MUST be inside the player beefweb "music directories".
# STREAM_CACHE_DIR=           # default: ~/.cache/cove-stream-bot
# STREAM_CACHE_MAX_FILES=60
